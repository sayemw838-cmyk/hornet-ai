# Supabase project URL and publishable key are public identifiers; server key is a secret.
SUPABASE_URL=https://<hornet-project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-key>
SUPABASE_SERVICE_ROLE_KEY=<server-secret-injected-by-runtime-secret-store>

# API/worker settings
HORNET_API_HOST=127.0.0.1
HORNET_API_PORT=8787
HORNET_WORKER_ID=hornet-local-worker
HORNET_POLL_MS=3000
HORNET_SCHEDULER_POLL_MS=30000
HORNET_MAX_CLAIM=5
HORNET_LEASE_SECONDS=60

# Model use is disabled unless an operator deliberately configures a provider.
# For OpenAI-compatible services, explicitly set provider, endpoint, model, API key,
# request limit and budget. Do not assume a provider/model is free.
HORNET_MODEL_PROVIDER=disabled
HORNET_MODEL_BASE_URL=
HORNET_MODEL_ID=
HORNET_MODEL_API_KEY=<inject-through-secret-store-never-commit>
HORNET_MODEL_MAX_CALLS_PER_RUN=6
HORNET_MODEL_MAX_OUTPUT_TOKENS=1200
HORNET_MODEL_MAX_INPUT_TOKENS=6000
HORNET_MODEL_MAX_COST_USD_PER_RUN=0
HORNET_MODEL_INPUT_USD_PER_MILLION_TOKENS=
HORNET_MODEL_OUTPUT_USD_PER_MILLION_TOKENS=
HORNET_MODEL_BILLING_APPROVED=false
